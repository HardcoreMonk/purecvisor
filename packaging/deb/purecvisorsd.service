                          
                                                                              
                                                                    
                                                            
                                                            
                                                                 
                                                                  
 
                      
                                                 
                                                     
                                                      
[Unit]
Description=PureCVisor Single Edge - KVM Hypervisor Orchestrator
Documentation=file:/usr/local/share/purecvisor/ui/guide.html
After=network-online.target libvirtd.service ovs-vswitchd.service ovn-central.service ovn-host.service ovn-controller.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/local/bin/purecvisorsd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
WatchdogSec=60
                                                                         
                                               
                                                                         
                                                                              
                                                               
                                            
                                                             
                                                             
                                                                  
                         
                                         
TimeoutStartSec=150
                                                      
                                                                            
                                                                 
                                              
                                                                   
                                                     
                                                                            
                                              
                                                        
                                                      
                                                         
                
TimeoutStopSec=180
KillSignal=SIGTERM
                                                      
                                                 
KillMode=process
UMask=0077
                                                          
                                                                
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_TIME CAP_MAC_OVERRIDE CAP_MAC_ADMIN
LimitNOFILE=1048576
TasksMax=4096
Delegate=yes
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2
Environment=LIBVIRT_DEFAULT_URI=qemu:///system
ExecStartPost=/bin/sh -c 'for i in $(seq 1 50); do if [ -S /var/run/purecvisor/daemon.sock ]; then chown root:root /var/run/purecvisor/daemon.sock; chmod 0600 /var/run/purecvisor/daemon.sock; exit 0; fi; sleep 0.1; done; exit 0'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

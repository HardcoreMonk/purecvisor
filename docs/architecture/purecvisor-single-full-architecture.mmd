flowchart TB
    subgraph clients ["사용자와 외부 소비자"]
        direction LR
        webUi["Web UI"]
        pcvctl["pcvctl CLI"]
        apiClient["REST API client"]
        grpcClient["gRPC client"]
        promClient["Prometheus scraper"]
    end

    subgraph edgeGateway ["외부 TLS 경계"]
        nginx["nginx TLS termination"]
    end

    subgraph bootInputs ["부팅 입력"]
        configStore["daemon.conf and secret sources"]
        kernelLsm["Kernel LSM list with optional bpf"]
    end

    subgraph daemon ["purecvisorsd 단일 프로세스"]
        direction TB

        subgraph transports ["API transport"]
            direction LR
            udsApi["UDS JSON-RPC 2.0"]
            restApi["REST API with libsoup3"]
            grpcApi["gRPC with protobuf-c"]
            wsApi["WebSocket event channel"]
        end

        subgraph core ["GMainLoop control plane"]
            direction LR
            mainLoop["Bootstrap and lifecycle"]
            dispatcher["Dispatcher: policy, RBAC, owner scope, O(1) routing"]
            handlers["Domain RPC handlers"]
            syncPath["Immediate JSON-RPC response"]
            workerPool["GTask bounded worker pool"]
            completion["Job result, audit, WebSocket completion"]
        end

        subgraph domains ["도메인 모듈"]
            direction LR
            workloadDomain["Workload: VM, LXC, template, GPU"]
            networkDomain["Network: bridge, Local VPC, OVS and OVN, SG, QoS"]
            storageDomain["Storage: ZFS, snapshot, backup, iSCSI, cloud jobs"]
            securityDomain["Security: JWT, TOTP, RBAC, audit, HIDS, HIPS, BPF LSM audit"]
            monitorDomain["Monitoring: host telemetry, process status, Prometheus"]
            opsDomain["Operations: telemetry, alerts, Web Push, AI healing, plugins"]
        end
    end

    subgraph persistence ["로컬 영속 상태"]
        direction LR
        coreDb["Core / identity / security / network DBs (SQLite WAL, 7 files)<br/>vm_state.db, pcv_audit.db, pcv_jobs.db, rbac.db<br/>pcv_security.db, security_groups.db, vpc.db"]
        operationsDb["Operations DBs (SQLite WAL, 2 files)<br/>cloud_jobs.db, pcv_webpush.db"]
        desiredStore["Desired state: networks, overlay, QoS, BPF, backups"]
    end

    subgraph host ["Linux and KVM host"]
        direction LR
        virtPlatform["Virtualization: libvirt, QEMU, KVM, LXC"]
        storagePlatform["Storage: ZFS, LIO, open-iscsi"]
        networkPlatform["Network: Linux bridge, nftables, dnsmasq, WireGuard, tc, eBPF, OVS, OVN"]
        securityPlatform["Host security: kernel LSM, bpffs, Suricata, systemd, journald, cgroups, PSI"]
        accelPlatform["Acceleration: GPU, SR-IOV, DPDK"]
    end

    webUi <-->|"HTTPS and WebSocket"| nginx
    apiClient <-->|"HTTPS"| nginx
    promClient -->|"Scrape metrics"| nginx
    pcvctl <-->|"Local socket"| udsApi
    grpcClient <-->|"Binary RPC"| grpcApi
    nginx <-->|"Static UI and REST"| restApi
    nginx <-->|"WebSocket upgrade"| wsApi

    udsApi -->|"JSON-RPC"| dispatcher

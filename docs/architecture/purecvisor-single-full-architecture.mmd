    grpcApi -->|"RPC"| dispatcher
    mainLoop -->|"Owns lifecycle"| dispatcher
    configStore -->|"Boot policy"| mainLoop
    kernelLsm -->|"BPF readiness"| securityDomain

    dispatcher -->|"Validated request"| handlers

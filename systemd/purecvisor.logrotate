/var/log/purecvisor/*.log {
    daily
    maxsize 500M
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0640 root root
    sharedscripts
    postrotate
        systemctl reload purecvisorsd 2>/dev/null || true
    endscript
}

/var/log/ovn/ovn-controller.log {
    daily
    maxsize 200M
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    copytruncate
    create 0640 root root
}

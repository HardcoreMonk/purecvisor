    SCRIPT_DIR="$(git rev-parse --show-toplevel)/scripts"
    SEL_OUT=$(python3 "$SCRIPT_DIR/check_test_runner_selectors.py" --self-test 2>&1)
    SEL_RC=$?
    if [ $SEL_RC -eq 0 ] && [ ! -x ./test_runner ]; then
        SEL_OUT="$SEL_OUT
$(make test_runner 2>&1 | tail -5)"
        [ -x ./test_runner ] || SEL_RC=2
    fi
    if [ $SEL_RC -eq 0 ]; then
        SEL_OUT=$(python3 "$SCRIPT_DIR/check_test_runner_selectors.py" --test-runner ./test_runner 2>&1)
        SEL_RC=$?
    fi
    if [ $SEL_RC -ne 0 ]; then
        fail "시험 선택자 계약 위반 (suite prefix는 -r, 단일 leaf만 -p)"

#!/bin/bash
                          
                                                                           
                                                          
                                                                   
                                                                          
                                                                        
                                                                             
                                                     
 
                      
                                                                          
                                                                 
                                               
 
                        
                                                                
                                                       
 
                              
                                     
 
      
                      
 
        
                          
                                                                 

set -uo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

FAILED=0
GATE=0
TOTAL_GATES=0

pass() { echo -e "${GREEN}PASS${NC} $1"; }
fail() { echo -e "${RED}FAIL${NC} $1"; FAILED=1; }
warn() { echo -e "${YELLOW}WARN${NC} $1"; }
skip() { echo -e "${YELLOW}SKIP${NC} $1"; }

                                                        
                                          
mapfile -d '' -t STAGED_PATHS < <(git diff --cached --name-only --diff-filter=ACMR -z)
STAGED=$(printf '%s\n' "${STAGED_PATHS[@]}")
                                                                  
                                                               
COMMENT_DIFF_RC=0
mapfile -d '' -t COMMENT_STAGED_PATHS < <(
    git diff --cached --name-only --diff-filter=ACMRD --no-renames -z || printf '__PCV_COMMENT_DIFF_FAILED__\0'
)
for COMMENT_INDEX in "${!COMMENT_STAGED_PATHS[@]}"; do
    if [[ "${COMMENT_STAGED_PATHS[$COMMENT_INDEX]}" == "__PCV_COMMENT_DIFF_FAILED__" ]]; then
        COMMENT_DIFF_RC=2
        unset 'COMMENT_STAGED_PATHS[$COMMENT_INDEX]'
    fi
done

HAS_C_CHANGES=false
HAS_API_CHANGES=false
HAS_UI_CHANGES=false
HAS_RBAC_POLICY_CHANGES=false

echo "$STAGED" | grep -qE '\.(c|h)$' && HAS_C_CHANGES=true
echo "$STAGED" | grep -qE '(rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)|dispatcher[^/]*)\.(c|h)$' && HAS_API_CHANGES=true
echo "$STAGED" | grep -qE '^ui/' && HAS_UI_CHANGES=true
echo "$STAGED" | grep -qE '^(src/api/dispatcher[^/]*\.c|src/modules/dispatcher/.*|src/modules/auth/pcv_rbac\.(c|h)|src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|scripts/check_rbac_policies\.py)$' && HAS_RBAC_POLICY_CHANGES=true
HAS_CONTRACT_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/dispatcher[^/]*\.c|src/modules/dispatcher/.*|src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|src/api/grpc_server\.c|src/cli/purecvisorctl\.c|ui/.*\.js|scripts/check_rpc_consumers\.py|scripts/check_rpc_param_contract\.py|scripts/rpc_extract\.py|contracts/.*\.json)$' && HAS_CONTRACT_CHANGES=true
HAS_SYMBOL_CHANGES=false
echo "$STAGED" | grep -qE '\.(c|h)$|^scripts/(check_dead_exports\.py|dead_exports_baseline\.txt)$' && HAS_SYMBOL_CHANGES=true
HAS_INGRESS_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/(ws|uds|grpc)_server\.c|src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|src/api/dispatcher[^/]*\.c|src/modules/dispatcher/.*|src/modules/dispatcher/rpc_utils\.(c|h)|scripts/check_json_ingress\.py|scripts/check_mainloop_guest_agent\.py|scripts/tests/test_json_ingress\.py|contracts/json_ingress_trusted\.json)$' && HAS_INGRESS_CHANGES=true
HAS_SAFETY_CHANGES=false
echo "$STAGED" | grep -qE '\.c$|^(scripts/check_safety_controls\.py|contracts/safety_controls(\.json|_baseline\.txt))$' && HAS_SAFETY_CHANGES=true
HAS_ERROR_CODE_CHANGES=false
echo "$STAGED" | grep -qE '\.(c|h)$|^(scripts/check_error_codes\.py|scripts/error_codes_baseline\.txt)$' && HAS_ERROR_CODE_CHANGES=true
HAS_CLI_EXIT_CHANGES=false
echo "$STAGED" | grep -qE '^src/cli/(purecvisorctl|cli_rpc|cli_output)\.(c|h)$|^tests/integration/test_cli_(exit_status|help_readability)\.sh$' && HAS_CLI_EXIT_CHANGES=true
HAS_NETWORK_MODE_CONTRACT_CHANGES=false
echo "$STAGED" | grep -qE '^(ui/modules/network\.js|src/modules/network/network_manager\.c|src/bootstrap/pcv_bootstrap_single\.c|scripts/check_network_mode_contract\.py|scripts/tests/test_network_mode_contract\.py)$' && HAS_NETWORK_MODE_CONTRACT_CHANGES=true
HAS_ISCSI_CHAP_ARGV_CHANGES=false
echo "$STAGED" | grep -qE '^(src/modules/storage/(iscsi_manager|pcv_iscsi_node_db)\.(c|h)|tests/test_iscsi\.c|scripts/check_iscsi_chap_argv\.py|scripts/tests/test_iscsi_chap_argv\.py)$' && HAS_ISCSI_CHAP_ARGV_CHANGES=true
                                                                          
                                    
HAS_REST_CONTRACT_TEST_CHANGES=false
echo "$STAGED" | grep -qE '^src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|login|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)$' && HAS_REST_CONTRACT_TEST_CHANGES=true
HAS_VM_NAME_LOCK_TEST_CHANGES=false
echo "$STAGED" | grep -qE '^src/modules/dispatcher/handler_vm_(create|clone|lifecycle|rename|delete|guest|ova)\.c$' && HAS_VM_NAME_LOCK_TEST_CHANGES=true
HAS_JOB_SCHEMA_TEST_CHANGES=false
echo "$STAGED" | grep -qE '^(src/utils/pcv_job_(queue|recovery)\.(c|h)|src/utils/pcv_job_queue_internal\.h|src/utils/pcv_(config|log)\.h|src/api/drain\.(c|h)|src/modules/dispatcher/rpc_completion\.(c|h)|src/modules/dispatcher/rpc_utils\.h|tests/fixtures/(job_legacy_schema_probe\.c|job_queue_legacy\.h|job_recovery_probe\.c))$' && HAS_JOB_SCHEMA_TEST_CHANGES=true
HAS_CORS_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|scripts/check_cors_anchor\.py|scripts/tests/test_cors_anchor\.py)$' && HAS_CORS_CHANGES=true
HAS_SECRET_LOG_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|scripts/check_secret_logging\.py|scripts/tests/test_secret_logging\.py)$' && HAS_SECRET_LOG_CHANGES=true
HAS_SSRF_CHANGES=false
echo "$STAGED" | grep -qE '\.c$|^(scripts/check_ssrf_guard\.py|scripts/tests/test_ssrf_guard\.py)$' && HAS_SSRF_CHANGES=true
HAS_GRPC_AUTHZ_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/grpc_server\.c|scripts/check_grpc_authz\.py|scripts/tests/test_grpc_authz\.py)$' && HAS_GRPC_AUTHZ_CHANGES=true
HAS_SSRF_TARGET_CHANGES=false
echo "$STAGED" | grep -qE '\.c$|^(scripts/check_ssrf_target_guard\.py|scripts/tests/test_ssrf_target_guard\.py)$' && HAS_SSRF_TARGET_CHANGES=true
HAS_AUDIT_HASHCHAIN_CHANGES=false
echo "$STAGED" | grep -qE '^(src/modules/audit/pcv_audit\.(c|h)|src/modules/audit/pcv_audit_chain\.c|src/main\.c|src/modules/daemons/ebpf_telemetry\.c|src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|scripts/check_audit_hashchain\.py|scripts/tests/test_audit_hashchain\.py)$' && HAS_AUDIT_HASHCHAIN_CHANGES=true
HAS_RNG_SAFE_CHANGES=false
echo "$STAGED" | grep -qE '^(src/modules/auth/pcv_rbac\.c|src/utils/pcv_jwt\.c|scripts/check_rng_safe\.py|scripts/tests/test_rng_safe\.py)$' && HAS_RNG_SAFE_CHANGES=true
HAS_UDS_AUTHZ_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/uds_server\.c|src/utils/pcv_config\.c|scripts/check_uds_authz\.py|scripts/tests/test_uds_authz\.py)$' && HAS_UDS_AUTHZ_CHANGES=true
HAS_TRANSPORT_BIND_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|src/main\.c|scripts/check_transport_bind\.py|scripts/tests/test_transport_bind\.py)$' && HAS_TRANSPORT_BIND_CHANGES=true
HAS_CONTAINER_OWNER_SCOPE_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/dispatcher[^/]*\.c|src/modules/dispatcher/.*|src/modules/dispatcher/handler_container\.c|src/modules/lxc/lxc_owner\.(c|h)|scripts/check_container_owner_scope\.py|scripts/tests/test_container_owner_scope\.py)$' && HAS_CONTAINER_OWNER_SCOPE_CHANGES=true
HAS_MTLS_WIRING_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|src/utils/pcv_tls\.(c|h)|scripts/check_mtls_wiring\.py|scripts/tests/test_mtls_wiring\.py)$' && HAS_MTLS_WIRING_CHANGES=true
HAS_TLS_MIN_VERSION_CHANGES=false
echo "$STAGED" | grep -qE '^(src/utils/pcv_tls\.(c|h)|scripts/check_tls_min_version\.py|scripts/tests/test_tls_min_version\.py)$' && HAS_TLS_MIN_VERSION_CHANGES=true
HAS_SECURITY_HEADERS_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/rest_(server|policy|response|request|async|transport|request_auth|internal|prelude|public|public_render|auth_endpoints|map_compute|map_observe|map_platform)\.(c|h)|scripts/check_security_headers\.py|scripts/tests/test_security_headers\.py)$' && HAS_SECURITY_HEADERS_CHANGES=true
HAS_PASSWORD_POLICY_CHANGES=false
echo "$STAGED" | grep -qE '^(src/modules/dispatcher/handler_auth\.c|src/utils/pcv_validate\.(c|h)|scripts/check_password_policy\.py|scripts/tests/test_password_policy\.py)$' && HAS_PASSWORD_POLICY_CHANGES=true
HAS_WS_TOKEN_URL_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/ws_server\.c|scripts/check_ws_token_url\.py|scripts/tests/test_ws_token_url\.py)$' && HAS_WS_TOKEN_URL_CHANGES=true
HAS_ZPOOL_RECOVER_CHANGES=false
echo "$STAGED" | grep -qE '^(src/modules/storage/zfs_driver\.(c|h)|src/modules/daemons/ebpf_telemetry\.c|scripts/check_zpool_suspend_recover\.py|scripts/tests/test_zpool_suspend_recover\.py)$' && HAS_ZPOOL_RECOVER_CHANGES=true
HAS_DEB_APPARMOR_CHANGES=false
echo "$STAGED" | grep -qE '^(packaging/deb/build-deb\.sh|packaging/apparmor/(pcv-apparmor|usr\.local\.bin\.purecvisorsd)|docs/adr/0028-2\.0-host-hardening-hidepid-over-apparmor-confinement\.md|scripts/check_deb_apparmor\.py|scripts/tests/test_deb_apparmor\.py)$' && HAS_DEB_APPARMOR_CHANGES=true
HAS_SPAWN_CAPABILITY_CHANGES=false
echo "$STAGED" | grep -qE '^(src/.*\.[ch]|packaging/deb/(purecvisorsd\.service|purecvisor-lio\.conf)|scripts/check_spawn_capability_contract\.py|Makefile)$' && HAS_SPAWN_CAPABILITY_CHANGES=true
HAS_PUBLIC_COMMENT_CHANGES=true

                                                                   
HAS_HELP_COUNT_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/dispatcher[^/]*\.c|src/modules/dispatcher/.*|ui/modules/help\.js|ui/app\.js|scripts/check_help_counts\.py)$' && HAS_HELP_COUNT_CHANGES=true

                                                                                  
HAS_HELP_CONTRACT_CHANGES=false
echo "$STAGED" | grep -qE '^(src/api/dispatcher[^/]*\.c|src/api/rest_[^/]*\.c|src/modules/.*\.c|ui/modules/help\.js|docs/GUIDE\.md|ui/guide-content\.md|scripts/(check_help_contract|check_fe_rpc_params|check_rbac_policies|check_help_counts|extract_rest_routes|rpc_extract)\.py|scripts/tests/test_help_contract\.py)$' && HAS_HELP_CONTRACT_CHANGES=true

                                                                          
                                                                  
                                                             
HAS_DEAD_EXPORT_ACCEPT_CHANGES=false
echo "$STAGED" | grep -qE '^scripts/(check_dead_exports\.py|dead_exports_baseline\.txt|tests/test_dead_exports_acceptance\.py)$' && HAS_DEAD_EXPORT_ACCEPT_CHANGES=true
$HAS_DEAD_EXPORT_ACCEPT_CHANGES && HAS_SYMBOL_CHANGES=true

                                                             
                          
                                                                           
                                                                              
                                                               
                             
                                                                        
                                                                                        
                                                                           
                                                                        
                                                                        
                                                                                
                                                                           
                                                                      
                                                                
                                                                
                                                                                        
PCV_BG_DIR=""
declare -A PCV_BG_PID=()
PCV_BG_RC=0
PCV_BG_OUT=""

pcv_bg_start() {
                                                                  
    local name="$1"
    shift
    "$@" >"$PCV_BG_DIR/$name.log" 2>&1 </dev/null &
    PCV_BG_PID[$name]=$!
}

pcv_bg_collect() {
                                                                         
    local name="$1" pid="${PCV_BG_PID[$1]:-}"
    PCV_BG_RC=125
    PCV_BG_OUT="백그라운드 작업 '$name'이 시작되지 않았다"
    [ -n "$pid" ] || return 0
    wait "$pid"
    PCV_BG_RC=$?
    unset "PCV_BG_PID[$name]"
    PCV_BG_OUT=$(cat -- "$PCV_BG_DIR/$name.log" 2>/dev/null || true)
}

pcv_bg_cleanup() {
                                                                             
    local name pid live tries=0
    for name in "${!PCV_BG_PID[@]}"; do
        kill -TERM "${PCV_BG_PID[$name]}" 2>/dev/null || true
    done
    while [ "${#PCV_BG_PID[@]}" -gt 0 ] && [ "$tries" -lt 10 ]; do
        live=0
        for name in "${!PCV_BG_PID[@]}"; do
            kill -0 "${PCV_BG_PID[$name]}" 2>/dev/null && live=1
        done
        [ "$live" -eq 0 ] && break
        sleep 0.5
        tries=$((tries + 1))
    done
    for name in "${!PCV_BG_PID[@]}"; do
        pid="${PCV_BG_PID[$name]}"
        kill -KILL -- "-$pid" 2>/dev/null || true
        kill -KILL "$pid" 2>/dev/null || true
    done
    PCV_BG_PID=()
    if [ -n "$PCV_BG_DIR" ]; then
        rm -rf -- "$PCV_BG_DIR" 2>/dev/null || true
        PCV_BG_DIR=""
    fi
}

trap 'pcv_bg_cleanup' EXIT
trap 'pcv_bg_cleanup; exit 130' INT
trap 'pcv_bg_cleanup; exit 143' TERM
trap 'pcv_bg_cleanup; exit 129' HUP
                    

PCV_TOP="$(git rev-parse --show-toplevel)"
PCV_SAN_TREE=""
PCV_SAN_PREP_ERR=""
PCV_SAN_STARTED=false
PCV_FG_TMP=""
                                                                                                     
                                                                              
                                                                                                     
                                                                            
                                                                    
PCV_SKIP_ROOT_SAN=false
[ "$(git config --get --bool pcv.hook.skipRootSanitize 2>/dev/null)" = "true" ] && PCV_SKIP_ROOT_SAN=true
                                                                                                   
                                                                                         
                                                                               
                                                                                             
                                                                                               
                                                                                 
                                                         
PCV_SKIP_LIVE_INTEG=false
[ "$(git config --get --bool pcv.hook.skipLiveIntegration 2>/dev/null)" = "true" ] && PCV_SKIP_LIVE_INTEG=true

pcv_start_asan() {
                                                                         
                                                               
                                                                             
                                                              
    local jobs=$(( $(nproc 2>/dev/null || echo 2) / 2 ))
    [ "$jobs" -ge 1 ] || jobs=1
    pcv_bg_start asan env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
        -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_COMMON_DIR -u GIT_PREFIX \
        MAKEFLAGS="-j$jobs" CCACHE_NOHASHDIR=1 PCV_SANITIZE_DISPOSABLE_TREE=1 \
        timeout 300 make -C "$PCV_SAN_TREE" --no-print-directory sanitize
    PCV_SAN_STARTED=true
}

if $HAS_SYMBOL_CHANGES || $HAS_C_CHANGES; then
    PCV_BG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/pcv-precommit-bg.XXXXXX") || PCV_BG_DIR=""
fi
if [ -n "$PCV_BG_DIR" ]; then
    if $HAS_SYMBOL_CHANGES; then
        pcv_bg_start dead_export python3 "$PCV_TOP/scripts/check_dead_exports.py"
        if $HAS_DEAD_EXPORT_ACCEPT_CHANGES; then
            pcv_bg_start dead_export_accept python3 "$PCV_TOP/scripts/tests/test_dead_exports_acceptance.py"
        fi
    fi
    if $HAS_C_CHANGES && ! $PCV_SKIP_ROOT_SAN; then
                                                                                       
        PCV_SAN_TREE="$PCV_BG_DIR/staged-tree"
        if PCV_SAN_PREP_ERR=$(git checkout-index -a --prefix="$PCV_SAN_TREE/" 2>&1); then
                                                                                      
                                                                                               
                                                                                           
                                                                                                            
                                                                                  
            PCV_FG_TMP="$PCV_BG_DIR/fg-tmp"
            mkdir -p "$PCV_FG_TMP" || PCV_FG_TMP=""
                                                                                                     
            if [ "${PCV_PRECOMMIT_ROOT_TEST:-0}" != "1" ]; then
                pcv_start_asan
            fi
        else
            PCV_SAN_TREE=""
        fi
    fi
elif $HAS_SYMBOL_CHANGES || $HAS_C_CHANGES; then
    PCV_SAN_PREP_ERR="mktemp -d 실패 — 백그라운드 작업 디렉터리를 만들지 못했다"
fi

pcv_show_build_errors() {
                                                         
    echo "$1" | grep -E "error:|undefined reference|\*\*\*" | head -15
}

                                                       
if $HAS_C_CHANGES; then
    GATE=$((GATE+1))
    echo -e "${CYAN}[$GATE] 클러스터 빌드 검증 (경고 0)${NC}"
    BUILD_OUT=$(make all 2>&1)
    BUILD_RC=$?
    WARNINGS=$(echo "$BUILD_OUT" | grep -c "warning:" || true)
                                                            
    if [ "$BUILD_RC" -ne 0 ]; then
        fail "빌드 실패 (make all 종료 코드 $BUILD_RC)"
        pcv_show_build_errors "$BUILD_OUT"
    fi
    if [ "$WARNINGS" -gt 0 ]; then
        fail "빌드 경고 ${WARNINGS}건 발견"
        echo "$BUILD_OUT" | grep "warning:" | head -5
    elif [ "$BUILD_RC" -eq 0 ]; then
        pass "빌드 경고 0건"
    fi
else
    skip "[1] C 소스 변경 없음 — 빌드 검증 생략"
fi

                                                           
if $HAS_C_CHANGES; then
    GATE=$((GATE+1))
    echo -e "${CYAN}[$GATE] Single Edge 빌드 검증${NC}"
    SINGLE_OUT=$(make clean >/dev/null 2>&1 && make single 2>&1)
    SINGLE_RC=$?
                                                   
    SINGLE_WARNS=$(echo "$SINGLE_OUT" | grep -c "warning:" || true)
    if [ "$SINGLE_RC" -ne 0 ]; then
        fail "Single Edge 빌드 실패 (make clean·single 종료 코드 $SINGLE_RC)"
        pcv_show_build_errors "$SINGLE_OUT"
    fi
    if [ "$SINGLE_WARNS" -gt 0 ]; then
        fail "Single Edge 빌드 신규 경고 ${SINGLE_WARNS}건"
    elif [ "$SINGLE_RC" -eq 0 ]; then
        pass "Single Edge 빌드 경고 0건"
    fi
                          
    make clean >/dev/null 2>&1 && make single >/dev/null 2>&1
fi

                                                            










pcv_unit_test_verdict() {

    local status="$1" log="$2" fails bails passes
    fails=$(grep -c "^not ok" "$log" || true)
    bails=$(grep -c "Bail out!" "$log" || true)
    passes=$(grep "^ok " "$log" | grep -vc "# SKIP" || true)
    if [ "$status" -ne 0 ]; then
        fail "유닛 테스트 종료코드 ${status} (러너 실패 또는 사전 계약 gate 실패)"
        grep -E "^not ok|Bail out!|Error|❌" "$log" | head -20
        return 1
    elif [ "$bails" -gt 0 ]; then
        fail "러너 중단(Bail out!) ${bails}건"
        grep -B2 "Bail out!" "$log" | head -20
        return 1
    elif [ "$fails" -gt 0 ]; then
        fail "${fails}건 테스트 실패"
        grep "^not ok" "$log"
        return 1
    elif [ "$passes" -lt 200 ]; then
        fail "테스트 ${passes}건만 통과(SKIP 제외, 최소 200건 필요 — 테스트 등록 누락?)"
        return 1
    fi
    pass "${passes}건 테스트 통과 (SKIP 제외)"
    return 0
}

if $HAS_C_CHANGES; then
    GATE=$((GATE+1))
    echo -e "${CYAN}[$GATE] 유닛 테스트${NC}"

    TEST_LOG=$(mktemp "${TMPDIR:-/tmp}/pcv-precommit-test.XXXXXX")
    if [ "${PCV_PRECOMMIT_ROOT_TEST:-0}" = "1" ]; then
        warn "PCV_PRECOMMIT_ROOT_TEST=1 — sudo make test (운영 겸용 호스트에서는 금지)"
        make test >"$TEST_LOG" 2>&1
        TEST_STATUS=$?
    elif [ "$(id -u)" -eq 0 ]; then
        echo "root 커밋에서 ./test_runner를 직접 돌리면 root 시험이 된다" >"$TEST_LOG"
        TEST_STATUS=1
        fail "root로 커밋 중 — 비root 사용자로 커밋하거나 PCV_PRECOMMIT_ROOT_TEST=1을 명시하십시오"
    else
        (
                                                                         
            [ -n "$PCV_FG_TMP" ] && export TMPDIR="$PCV_FG_TMP"
            make test_runner tests/audit_startup_test check-q35-hotplug-xml \
                check-server-defect-contracts check-dpdk-owned-lifecycle &&
            ./test_runner -v &&
            ./tests/audit_startup_test -v
        ) >"$TEST_LOG" 2>&1
        TEST_STATUS=$?
    fi
    if [ "$(id -u)" -ne 0 ] || [ "${PCV_PRECOMMIT_ROOT_TEST:-0}" = "1" ]; then
        pcv_unit_test_verdict "$TEST_STATUS" "$TEST_LOG" || true
    fi
    rm -f "$TEST_LOG"
else
    skip "[3] C 소스 변경 없음 — 테스트 생략"
fi
                                                                                                 
if [ -n "$PCV_SAN_TREE" ] && ! $PCV_SAN_STARTED; then
    pcv_start_asan
fi

                                                                      
                                                                                        
                                                                       
                                                                          
                                                                        
                                    
                                                              
                  
HAS_SELECTOR_CONTRACT_CHANGES=false
echo "$STAGED" | grep -qE '^(tests/test_[^/]*\.c|docs/GUIDE\.md|docs/DEVELOPMENT_VERIFICATION_POLICY\.md|docs/ADR_INDEX\.md|docs/adr/[^/]*\.md|scripts/check_test_runner_selectors\.py)$' && HAS_SELECTOR_CONTRACT_CHANGES=true
if $HAS_SELECTOR_CONTRACT_CHANGES; then
    GATE=$((GATE+1))

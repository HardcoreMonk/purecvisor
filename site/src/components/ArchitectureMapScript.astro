<script>
  const maps = Array.from(document.querySelectorAll(".pcv-control-map[data-active-path]"));

  for (const map of maps) {
    const controls = Array.from(map.querySelectorAll(".pcv-arch-path-trigger"));
    const outputs = Array.from(map.querySelectorAll("[data-pcv-path-output]"));

    function selectPath(control) {
      const path = control.dataset.path;
      if (!path) return;
      map.dataset.activePath = path;
      for (const item of controls) {
        const active = item === control;
        item.setAttribute("aria-pressed", active ? "true" : "false");
        item.tabIndex = active ? 0 : -1;
      }
      for (const output of outputs) {
        output.textContent = control.dataset.pathLabel || control.textContent.trim();
      }
    }

    for (const [index, control] of controls.entries()) {
      control.addEventListener("click", () => selectPath(control));
      control.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % controls.length;
        if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + controls.length) % controls.length;
        if (event.key === "Home") next = 0;
        if (event.key === "End") next = controls.length - 1;
        if (next === index) return;
        event.preventDefault();
        selectPath(controls[next]);
        controls[next].focus();
      });
    }

    const initial = controls.find((control) => control.dataset.path === map.dataset.activePath) || controls[0];
    if (initial) selectPath(initial);
  }
</script>

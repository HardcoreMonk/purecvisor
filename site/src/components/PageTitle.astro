---
import DefaultPageTitle from "@astrojs/starlight/components/PageTitle.astro";

const isLanding = [
  "/",
  "/index.html",
  "/ko",
  "/ko/",
  "/ko/index.html",
  "/en",
  "/en/",
  "/en/index.html"
].includes(Astro.url.pathname);
const isNetworking = Astro.url.pathname === "/ko/infrastructure/networking/";
---

{isLanding ? null : (
  <>
    {isNetworking ? <p class="pcv-network-page-kicker">인프라 · Single Edge</p> : null}
    <DefaultPageTitle />
    {isNetworking ? (
      <p class="pcv-network-page-lead">
        VM 연결 방식부터 tenant 격리, 트래픽 정책, 가속과 관측까지 네트워크 서비스를 구성 순서와 실제 확인 지점에 맞춰 설명합니다.
      </p>
    ) : null}
  </>
)}

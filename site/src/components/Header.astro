---
import config from "virtual:starlight/user-config";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import { guideEntryPath, guidePath } from "../../scripts/guide-routes.mjs";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
const pathname = Astro.url.pathname;
const localePrefix = pathname === "/en" || pathname.startsWith("/en/")
  ? "/en"
  : pathname === "/ko" || pathname.startsWith("/ko/")
    ? "/ko"
    : "";
const isEnglish = localePrefix === "/en";
const languageLabel = isEnglish ? "Language" : "언어";
const navigationLabel = isEnglish ? "Primary navigation" : "주요 탐색";

const menus = isEnglish
  ? [
      {
        label: "Services",
        items: [
          ["Service overview", guidePath(1)],
          ["VMs & containers", guidePath(3)],
          ["Networking", guidePath(6)],
          ["Observability & security", guidePath(8)]
        ]
      },
      {
        label: "Get started",
        items: [
          ["5-minute quickstart", guidePath(1, "#14-5분-퀵스타트")],
          ["Installation & environment", guidePath(2)],
          ["Start the service", guidePath(1, "#14-5분-퀵스타트")],
          ["Create your first VM", guidePath(3)]
        ]
      },
      {
        label: "Public scope",
        items: [
          ["Scope overview", guidePath(1, "#공개-범위-핵심")],
          ["Single Edge boundaries", guidePath(1)],
          ["Architecture", guidePath(1, "#12-아키텍처-개요")],
          ["Quality gates", guidePath(22)]
        ]
      },
      {
        label: "Documentation",
        items: [
          ["Full operations guide", guideEntryPath],
          ["REST API", guidePath(14)],
          ["CLI reference", guidePath(15)],
          ["Troubleshooting", guidePath(17)]
        ]
      }
    ]
  : [
      {
        label: "서비스",
        items: [
          ["서비스 개요", guidePath(1)],
          ["VM · 컨테이너", guidePath(3)],
          ["네트워크", guidePath(6)],
          ["관측 · 보안", guidePath(8)]
        ]
      },
      {
        label: "시작하기",
        items: [
          ["5분 퀵스타트", guidePath(1, "#14-5분-퀵스타트")],
          ["설치 및 환경 구성", guidePath(2)],
          ["서비스 시작 흐름", guidePath(1, "#14-5분-퀵스타트")],
          ["첫 VM 만들기", guidePath(3)]
        ]
      },
      {
        label: "공개 범위",
        items: [
          ["공개 범위 개요", guidePath(1, "#공개-범위-핵심")],
          ["Single Edge 경계", guidePath(1)],
          ["아키텍처", guidePath(1, "#12-아키텍처-개요")],
          ["품질 게이트", guidePath(22)]
        ]
      },
      {
        label: "문서",
        items: [
          ["전체 운영 가이드", guideEntryPath],
          ["REST API", guidePath(14)],
          ["CLI 레퍼런스", guidePath(15)],
          ["트러블슈팅", guidePath(17)]
        ]
      }
    ];
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    <nav class="pcv-language-switch pcv-language-switch-mobile" aria-label={languageLabel}>
      <a href="/ko/" lang="ko" hreflang="ko" aria-current={!isEnglish ? "true" : undefined}>KO</a>
      <a href="/en/" lang="en" hreflang="en" aria-current={isEnglish ? "true" : undefined}>EN</a>
    </nav>
  </div>
  <nav class="pcv-primary-nav print:hidden" aria-label={navigationLabel}>
    {menus.map((group, index) => (
      <div class="pcv-nav-group">
        <button
          class="pcv-nav-trigger"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls={`pcv-nav-menu-${index}`}
        >
          {group.label}
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d="m4 6 4 4 4-4" />
          </svg>
        </button>
        <div class="pcv-nav-menu" id={`pcv-nav-menu-${index}`} hidden>
          {group.items.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>
    ))}
  </nav>
  <div class="search-group sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="right-group print:hidden">
    <div class="social-icons sl-flex">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <nav class="pcv-language-switch" aria-label={languageLabel}>
      <a href="/ko/" lang="ko" hreflang="ko" aria-current={!isEnglish ? "true" : undefined}>KO</a>
      <a href="/en/" lang="en" hreflang="en" aria-current={isEnglish ? "true" : undefined}>EN</a>
    </nav>
  </div>
</div>

<script>
  import {
    enhanceArchitecturePanel,
    resetArchitecturePanel
  } from "../scripts/architecture-interactions.js";

  const groups = Array.from(document.querySelectorAll(".pcv-nav-group"));
  const navCloseDelayMs = 160;
  const navCloseTimers = new WeakMap();

  function cancelGroupClose(group) {
    const timer = navCloseTimers.get(group);
    if (timer === undefined) return;
    window.clearTimeout(timer);
    navCloseTimers.delete(group);
  }

  function setGroupOpen(group, open) {
    cancelGroupClose(group);
    const trigger = group.querySelector(".pcv-nav-trigger");
    const menu = group.querySelector(".pcv-nav-menu");
    if (!(trigger instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    trigger.setAttribute("aria-expanded", open ? "true" : "false");
    menu.hidden = !open;
  }

  function scheduleGroupClose(group) {
    cancelGroupClose(group);
    const timer = window.setTimeout(() => {
      navCloseTimers.delete(group);
      setGroupOpen(group, false);
    }, navCloseDelayMs);
    navCloseTimers.set(group, timer);
  }

  function closeGroups(except) {
    for (const group of groups) {
      if (group !== except) setGroupOpen(group, false);
    }
  }

  for (const group of groups) {
    const trigger = group.querySelector(".pcv-nav-trigger");
    const menu = group.querySelector(".pcv-nav-menu");
    if (!(trigger instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) continue;
    let restoringFocus = false;

    group.addEventListener("pointerenter", () => {
      closeGroups(group);
      setGroupOpen(group, true);
    });
    group.addEventListener("pointerleave", () => scheduleGroupClose(group));
    group.addEventListener("focusin", () => {
      if (restoringFocus) return;
      closeGroups(group);
      setGroupOpen(group, true);
    });
    group.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !group.contains(event.relatedTarget)) {
        setGroupOpen(group, false);
      }
    });
    trigger.addEventListener("click", () => {
      closeGroups(group);
      setGroupOpen(group, true);
    });
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setGroupOpen(group, true);
        menu.querySelector("a")?.focus();
      }
      if (event.key === "Escape") {
        event.preventDefault();
        setGroupOpen(group, false);
      }
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      event.preventDefault();
      setGroupOpen(group, false);
      restoringFocus = true;
      trigger.focus();
      restoringFocus = false;
    });
  }

  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Node) || groups.some((group) => group.contains(event.target))) return;
    closeGroups();
  });

  const codeLabel = document.documentElement.lang === "en" ? "Code example" : "코드 예제";
  document.querySelectorAll(".expressive-code pre").forEach((region, index) => {
    region.setAttribute("aria-label", `${codeLabel} ${index + 1}`);
  });

  const architectureTabGroups = document.querySelectorAll("[data-pcv-architecture-tabs]");
  for (const tabGroup of architectureTabGroups) {
    const tabs = Array.from(tabGroup.querySelectorAll("[data-pcv-architecture-tab]"));
    const panels = Array.from(tabGroup.querySelectorAll("[data-pcv-architecture-panel]"));

    function activateArchitectureTab(nextTab, moveFocus = false) {
      if (!(nextTab instanceof HTMLButtonElement)) return;
      const nextPanelId = nextTab.getAttribute("aria-controls");
      if (!nextPanelId || !panels.some((panel) => panel.id === nextPanelId)) return;

      for (const tab of tabs) {
        const selected = tab === nextTab;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.setAttribute("tabindex", selected ? "0" : "-1");
      }
      let nextPanel;
      for (const panel of panels) {
        resetArchitecturePanel(panel);
        panel.hidden = panel.id !== nextPanelId;
        if (!panel.hidden) nextPanel = panel;
      }
      if (nextPanel) void enhanceArchitecturePanel(nextPanel);
      if (moveFocus) nextTab.focus();
    }

    const initialPanel = panels.find((panel) => !panel.hidden);
    if (initialPanel) void enhanceArchitecturePanel(initialPanel);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateArchitectureTab(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;
        event.preventDefault();
        activateArchitectureTab(tabs[nextIndex], true);
      });
    });
  }
</script>

<style>
  @layer starlight.core {
    .header {
      display: grid;
      grid-template-columns: auto minmax(22rem, 1fr) minmax(11rem, 20rem) auto;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
      overflow: visible;
    }

    .title-wrapper {
      min-width: 0;
      margin: -0.25rem;
      overflow: visible;
      padding: 0.25rem;
    }

    .pcv-primary-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(0.15rem, 0.7vw, 0.6rem);
      min-width: 0;
    }

    .pcv-nav-group {
      position: relative;
    }

    .pcv-nav-group::after {
      position: absolute;
      top: 100%;
      left: 0;
      width: max(100%, 13.5rem);
      height: 0.45rem;
      content: "";
      pointer-events: none;
    }

    .pcv-nav-group:hover::after,
    .pcv-nav-group:focus-within::after {
      pointer-events: auto;
    }

    .pcv-nav-trigger {
      min-height: 2.25rem;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0 0.7rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--sl-color-gray-2);
      font: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
    }

    .pcv-nav-trigger svg {
      width: 0.75rem;
      height: 0.75rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.5;
      transition: transform 140ms ease;
    }

    .pcv-nav-trigger:hover,
    .pcv-nav-trigger[aria-expanded="true"] {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    .pcv-nav-trigger[aria-expanded="true"] svg {
      transform: rotate(180deg);
    }

    .pcv-nav-trigger:focus-visible,
    .pcv-nav-menu a:focus-visible,
    .pcv-language-switch a:focus-visible {
      outline: 3px solid var(--sl-color-accent);
      outline-offset: 3px;
    }

    .pcv-nav-menu {
      position: absolute;
      z-index: 20;
      top: calc(100% + 0.45rem);
      left: 0;
      min-width: 13.5rem;
      padding: 0.45rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.75rem;
      background: var(--sl-color-black);
      box-shadow: 0 16px 34px rgba(15, 23, 42, 0.16);
    }

    .pcv-nav-menu[hidden] {
      display: none;
    }

    .pcv-nav-menu a {
      min-height: 2.45rem;
      display: flex;
      align-items: center;
      padding: 0.45rem 0.7rem;
      border-radius: 0.5rem;
      color: var(--sl-color-gray-2);
      font-size: 0.84rem;
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
    }

    .pcv-nav-menu a:hover {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    .search-group {
      min-width: 0;
    }

    .right-group,
    .social-icons {
      display: flex;
      gap: 0.8rem;
      align-items: center;
    }

    .social-icons::after {
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
      content: "";
    }

    .pcv-language-switch {
      display: inline-flex;
      align-items: center;
      gap: 0.15rem;
      padding: 0.15rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 999px;
    }

    .pcv-language-switch a {
      min-width: 2rem;
      min-height: 1.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      color: var(--sl-color-gray-3);
      font-size: 0.67rem;
      font-weight: 700;
      text-decoration: none;
    }

    .pcv-language-switch a[aria-current="true"] {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    .pcv-language-switch-mobile {
      display: none;
      margin-inline-start: 0.6rem;
    }

    @media (max-width: 72rem) {
      .header {
        grid-template-columns: auto minmax(12rem, 1fr) auto;
      }

      .pcv-primary-nav {
        display: none;
      }
    }

    @media (max-width: 49.99rem) {
      .header {
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .title-wrapper {
        display: flex;
        align-items: center;
      }

      .pcv-language-switch-mobile {
        display: inline-flex;
      }

      .search-group {
        justify-self: end;
      }

      .right-group {
        display: none;
      }
    }
  }
</style>

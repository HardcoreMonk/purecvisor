---
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav class="pcv-primary-nav print:hidden" aria-label="주요 탐색">
    <a href="/#capabilities">서비스</a>
    <a href="/#quickstart">시작하기</a>
    <a href="/#scope">공개 범위</a>
    <a href="/#documentation">문서</a>
  </nav>
  <div class="search-group sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="right-group print:hidden">
    <div class="social-icons sl-flex">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: grid;
      grid-template-columns: auto minmax(17rem, 1fr) minmax(12rem, 22rem) auto;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      min-width: 0;
      margin: -0.25rem;
      overflow: clip;
      padding: 0.25rem;
    }

    .pcv-primary-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(0.75rem, 2vw, 1.6rem);
      min-width: 0;
    }

    .pcv-primary-nav a {
      color: var(--sl-color-gray-2);
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }

    .pcv-primary-nav a:hover {
      color: var(--sl-color-white);
    }

    .pcv-primary-nav a:focus-visible {
      outline: 3px solid var(--sl-color-accent);
      outline-offset: 4px;
    }

    .search-group {
      min-width: 0;
    }

    .right-group,
    .social-icons {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
      content: "";
    }

    @media (max-width: 68rem) {
      .header {
        grid-template-columns: auto minmax(12rem, 1fr) auto;
      }

      .pcv-primary-nav {
        display: none;
      }
    }

    @media (max-width: 49.99rem) {
      .header {
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .search-group {
        justify-self: end;
      }

      .right-group {
        display: none;
      }
    }
  }
</style>

---
import { serviceGroups, showcaseCopy } from '../data/service-videos.mjs';
import manifest from '../../public/assets/service-recordings/manifest.json';
const locale = Astro.props.locale === 'en' ? 'en' : 'ko';
const copy = showcaseCopy[locale];
const group = serviceGroups[0];
const clip = group.clips[0];
const duration = (id) => {
  const seconds = Math.round(manifest.videos.find(video => video.id === id).duration);
  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
};
---
<section class="pcv-showcase" id="service-demos" aria-labelledby="service-showcase-title" data-locale={locale}>
  <div class="pcv-shell">
    <div class="pcv-showcase-heading">
      <div>
        <p class="pcv-eyebrow">NETWORK SERVICES · {serviceGroups.reduce((count, item) => count + item.clips.length, 0)} {locale === 'en' ? 'RECORDINGS' : '개 검증 영상'}</p>
        <h2 id="service-showcase-title">{copy.heading}</h2>
      </div>
      <p class="pcv-showcase-lead">{copy.lead}</p>
    </div>
    <div class="pcv-service-tabs" role="tablist" aria-label={copy.category}>
      {serviceGroups.map((item, index) => (
        <button type="button" role="tab" id={`service-tab-${item.id}`} aria-controls="service-stage" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-service={item.id}>
          <span class="pcv-service-number" aria-hidden="true">0{index + 1}</span>
          <span class="pcv-service-name">{item.label}<span>{item[locale].tag}</span></span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
        </button>
      ))}
    </div>
    <div class="pcv-service-stage" id="service-stage" role="tabpanel" aria-labelledby="service-tab-vpc" tabindex="0">
      <div class="pcv-service-viewer">
        <div class="pcv-video-topline"><span><i aria-hidden="true"></i> PureCVisor <span data-video-service>Local VPC</span></span><span>{copy.recording}</span></div>
        <div class="pcv-video-frame">
          <img data-video-poster src={clip.poster} width="1440" height="900" loading="lazy" alt={clip[locale].title} />
          <video data-service-video hidden controls playsinline preload="none" aria-label={clip[locale].title} aria-describedby="service-scene-summary service-video-context"></video>
          <button class="pcv-video-play" data-video-play type="button" aria-label={`${copy.play}: ${clip[locale].title}`}>
            <span class="pcv-play-disc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z" /></svg></span>
            <span class="pcv-play-label">{copy.play} <span data-video-duration>{duration(clip.id)}</span></span>
          </button>
        </div>
        <div class="pcv-video-caption"><span data-video-status role="status" aria-live="polite">{copy.ready}</span><a data-video-direct href={clip.src} target="_blank" rel="noopener">{copy.direct} <span aria-hidden="true">↗</span></a><a data-video-original href={clip.original} target="_blank" rel="noopener">{copy.original} <span aria-hidden="true">↗</span></a><button data-video-retry hidden type="button">{copy.retry}</button></div>
        <div class="pcv-recording-description">
          <h3 data-scene-title>{clip[locale].title}</h3>
          <p class="pcv-video-scene-summary" id="service-scene-summary" data-scene-summary>{clip[locale].summary}</p>
        </div>
      </div>
      <div class="pcv-service-detail">
        <p class="pcv-service-overline" data-service-tag>{group[locale].tag}</p>
        <h3 data-service-title>{group[locale].title}</h3>
        <p class="pcv-service-description" data-service-description>{group[locale].description}</p>
        <p class="pcv-video-scene-heading">{copy.chapters}</p>
        <div class="pcv-video-scene-list" data-scene-list>
          {group.clips.map((item, index) => (
            <button class="pcv-video-scene" data-scene={item.id} data-duration={duration(item.id)} type="button" aria-pressed={index === 0 ? 'true' : 'false'}>
              <span class="pcv-video-scene-number" aria-hidden="true">0{index + 1}</span><span>{item[locale].title}</span><span class="pcv-video-scene-time">{duration(item.id)}</span>
            </button>
          ))}
        </div>
        <a class="pcv-service-guide" href="/ko/infrastructure/networking/">{copy.guide} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="pcv-showcase-footnote"><p id="service-video-context">{copy.context}</p><p data-service-note>{group[locale].note}</p></div>
    <noscript><p>{locale === 'en' ? 'Open a recording directly:' : '영상 파일을 직접 열어 보세요:'}</p><ul>{serviceGroups.flatMap(item => item.clips).map(item => <li><a href={item.src}>{item[locale].title}</a> · <a href={item.original}>{copy.original}</a><p>{item[locale].summary}</p></li>)}</ul></noscript>
  </div>
</section>
<script>
  import '../scripts/service-showcase.js';
</script>
